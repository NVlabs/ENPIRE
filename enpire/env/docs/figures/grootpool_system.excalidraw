    {
      "id": "side-ops-body",
      "type": "text",
      "x": 1290,
      "y": 220,
      "width": 400,
      "height": 800,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 602,
      "version": 1,
      "versionNonce": 602,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "open\n  req  : {op, model, task}\n  resp : {sid, worker_id, queued_ms}\n  state:\n    wid ← idle_workers.pop()\n    sessions[sid] = (wid, X_i, …)\n\nstep\n  req  : {op, sid, seq, obs}\n  resp : {seq, action}\n  state:\n    wid ← sessions[sid].worker_id\n    action ← WorkerHandle[wid](obs)\n\nclose\n  req  : {op, sid}\n  resp : {op: close_ok}\n  state:\n    wid ← sessions.pop(sid).worker_id\n    idle_workers.push(wid)\n\nping\n  resp : {n_sessions, queue_depth,\n         idle_workers}\n\nerror\n  code ∈ { no_worker,\n           unknown_session,\n           worker_crash,\n           worker_timeout,\n           bad_request,\n           internal }",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "open\n  req  : {op, model, task}\n  resp : {sid, worker_id, queued_ms}\n  state:\n    wid ← idle_workers.pop()\n    sessions[sid] = (wid, X_i, …)\n\nstep\n  req  : {op, sid, seq, obs}\n  resp : {seq, action}\n  state:\n    wid ← sessions[sid].worker_id\n    action ← WorkerHandle[wid](obs)\n\nclose\n  req  : {op, sid}\n  resp : {op: close_ok}\n  state:\n    wid ← sessions.pop(sid).worker_id\n    idle_workers.push(wid)\n\nping\n  resp : {n_sessions, queue_depth,\n         idle_workers}\n\nerror\n  code ∈ { no_worker,\n           unknown_session,\n           worker_crash,\n           worker_timeout,\n           bad_request,\n           internal }"
    }

